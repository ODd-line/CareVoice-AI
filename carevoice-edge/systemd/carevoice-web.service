[Unit]
Description=CareVoice Micro web application
After=network-online.target carevoice-model.service
Wants=network-online.target

[Service]
Type=simple
User=carevoice
Group=carevoice
WorkingDirectory=/opt/carevoice/app
EnvironmentFile=/etc/carevoice/carevoice.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=CAREVOICE_LAN_URL=http://carevoice-micro.local:3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/carevoice

[Install]
WantedBy=multi-user.target