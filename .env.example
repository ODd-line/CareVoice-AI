# Auth.js / Google OAuth
AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Comma-separated Google account emails authorized to select the staff role.
CAREVOICE_STAFF_EMAILS=staff@example.com,nurse@example.com

# Optional Gemini assistance. Keep provider API keys server-side only.
GOOGLE_GENERATIVE_AI_API_KEY=
CAREVOICE_GEMINI_MODEL=gemini-2.5-flash

# Optional hospital-hosted CareVoice model. The Next.js server calls this endpoint;
# browsers never receive the URL or token. This provider is tried before Gemini.
CAREVOICE_LLM_BASE_URL=
CAREVOICE_LLM_MODEL=carevoice-qwen-3b
CAREVOICE_LLM_API_KEY=
